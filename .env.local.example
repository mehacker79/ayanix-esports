# Copy this file to .env.local and fill in your own values.
# NEVER commit the real .env.local file — it's already in .gitignore.

# 1. EMAIL (GMAIL SMTP) — use a Google App Password, not your normal password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-sending-address@gmail.com
SMTP_PASS=your-16-digit-app-password

# 2. RAZORPAY
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# 3. DATABASE (MONGODB ATLAS)
MONGODB_URI=mongodb+srv://user:password@cluster0.mongodb.net/ayanix-esports?retryWrites=true&w=majority

# 4. ADMIN PANEL — checked server-side only in app/api/admin/auth/route.js.
# This value is NEVER sent to the browser. Use a long random password, not a
# dictionary phrase, and rotate it periodically.
ADMIN_EMAIL=your-admin-email@example.com
ADMIN_PASSWORD=replace-with-a-strong-random-password

# 5. USER LOGIN SESSIONS — signs the OTP-login session cookie.
# Generate one with: openssl rand -hex 32
AUTH_SECRET=replace-with-a-long-random-string
